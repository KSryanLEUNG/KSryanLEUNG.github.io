---
import '../styles/global.css';
import { site } from '../data/content';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  // Error pages are not indexed and have no canonical URL.
  noindex?: boolean;
  // Language versions of this page (including itself), for hreflang.
  alternates?: { hreflang: string; href: string }[];
}
const { title, description, type = 'website', publishedTime, modifiedTime, noindex = false, alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ka Sing (Ryan) Leung" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name.en} — Blog`} href="/rss.xml" />
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name.en} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Set theme & language before paint to avoid flash -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute('data-theme', storedTheme || (prefersDark ? 'dark' : 'light'));

        const storedLang = localStorage.getItem('lang');
        const browserZh = (navigator.language || '').toLowerCase().startsWith('zh');
        const lang = storedLang || (browserZh ? 'zh' : 'en');
        root.setAttribute('data-lang', lang);
        root.lang = lang === 'zh' ? 'zh-HK' : 'en';
        // Scroll-reveal hides content only when JS is running to reveal it again.
        root.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <slot />

    <script is:inline>
      (function () {
        const root = document.documentElement;

        // Theme toggle
        const themeBtn = document.getElementById('theme-toggle');
        const syncThemeBtn = () => {
          if (!themeBtn) return;
          themeBtn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
        };
        syncThemeBtn();
        // Follow the OS theme until the visitor picks one explicitly.
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (localStorage.getItem('theme')) return;
          root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
          syncThemeBtn();
        });
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            syncThemeBtn();
          });
        }

        // Mobile menu toggle
        const navToggle = document.getElementById('nav-toggle');
        const navHeader = document.querySelector('.nav');
        if (navToggle && navHeader) {
          const setMenu = (open) => {
            navHeader.classList.toggle('menu-open', open);
            navToggle.setAttribute('aria-expanded', String(open));
            navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            navToggle.textContent = open ? '✕' : '☰';
          };
          navToggle.addEventListener('click', () => {
            setMenu(!navHeader.classList.contains('menu-open'));
          });
          navHeader.querySelectorAll('.nav-links a').forEach((a) => {
            a.addEventListener('click', () => setMenu(false));
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && navHeader.classList.contains('menu-open')) {
              setMenu(false);
              navToggle.focus();
            }
          });
        }

        // Language toggle
        const langBtn = document.getElementById('lang-toggle');
        const syncLangLabel = () => {
          if (!langBtn) return;
          langBtn.textContent = root.getAttribute('data-lang') === 'zh' ? 'EN' : '中';
          document.documentElement.lang = root.getAttribute('data-lang') === 'zh' ? 'zh-HK' : 'en';
        };
        syncLangLabel();
        if (langBtn) {
          langBtn.addEventListener('click', () => {
            const next = root.getAttribute('data-lang') === 'zh' ? 'en' : 'zh';
            root.setAttribute('data-lang', next);
            localStorage.setItem('lang', next);
            syncLangLabel();
          });
        }

        // Reveal on scroll
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
